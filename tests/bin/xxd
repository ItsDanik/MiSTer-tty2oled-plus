#!/usr/bin/env python3
"""
Minimal xxd stand-in for the test suite.

MiSTer ships a real xxd and the daemon uses it, but plenty of build containers
do not have one. This covers only the two modes the daemon and the tests need:

    xxd -p        binary on stdin  -> plain hex on stdout
    xxd -r -p     plain hex stdin  -> binary on stdout

It is used only by tests, via tests/bin being prepended to PATH.
"""
import sys

args = set(sys.argv[1:])
revert = "-r" in args
plain = "-p" in args

if not plain:
    sys.exit("xxd shim: only -p and -r -p are supported")

if revert:
    # Real xxd -r -p is not "keep the hex digits and drop the rest". Derived
    # from it, byte for byte:
    #
    #   whitespace  is skipped and does not break a pair, so "a bc d" is abcd
    #   any other non-hex character is a separator AND discards a pending
    #               half-byte, so "0xa," is nothing at all and "0x1f," is 0x1f
    #   at end of input a pending half-byte is discarded, so "abc" is ab
    #
    # That middle rule is the one that matters here: the vendored artwork pack
    # is written "0X1f,0Xa2," and the leading 0 of each "0X" is swallowed by
    # the X. Stripping whitespace and calling bytes.fromhex - which is what
    # this shim used to do - raises on the first comma, so every real picture
    # in pics/ failed to decode on any machine without a real xxd.
    data = sys.stdin.buffer.read()
    out = bytearray()
    pending = None
    for ch in data.decode("ascii", "ignore"):
        if ch in "0123456789abcdefABCDEF":
            if pending is None:
                pending = ch
            else:
                out.append(int(pending + ch, 16))
                pending = None
        elif ch.isspace():
            continue
        else:
            pending = None
    sys.stdout.buffer.write(bytes(out))
else:
    data = sys.stdin.buffer.read()
    text = data.hex()
    # xxd -p wraps at 60 hex chars (30 bytes) per line.
    for i in range(0, len(text), 60):
        sys.stdout.write(text[i:i + 60] + "\n")
